# ==========================================
# AgroSmart Production Environment Template
# ==========================================

# Database (PostgreSQL with PostGIS)
# If using a managed database (Supabase, Neon, Render, Railway, AWS RDS):
DATABASE_URL=postgresql://user:password@host:5432/agrosmart?sslmode=require
DB_SSL=true

# Or discrete DB variables:
# DB_NAME=agrosmart
# DB_USER=postgres
# DB_PASS=your_strong_password
# DB_HOST=your_db_host
# DB_PORT=5432
# DB_DIALECT=postgres

# Server & Auth Configuration
PORT=5002
NODE_ENV=production
JWT_SECRET=generate_a_random_64_character_hex_key_here

# AI Microservice URL (Point backend to Flask AI service)
# In Docker Compose: http://ai:5001
# On Render/Railway: https://agrosmart-ai.onrender.com
AI_SERVER_URL=http://localhost:5001
FLASK_AI_URL=http://localhost:5001

# Google Gemini API Key (For farm recommendations and chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Environment (Vite frontend)
# Set in client/.env.production or host environment:
# VITE_API_URL=https://your-backend-domain.com/api
